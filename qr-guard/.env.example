# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
# .env 는 절대 커밋하지 마세요 (.gitignore 에 들어 있음).

# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=

# 판정에 쓸 모델명
LLM_MODEL=claude-opus-5-5

# 추론 깊이: low | medium | high  (낮을수록 빠르고 저렴)
LLM_EFFORT=medium

# 1 이면 같은 입력의 LLM 결과를 cache/ 폴더에 저장해 재사용 (평가 비용 절약)
LLM_CACHE=1
