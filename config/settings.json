{
  "fetch": {
    "timeout_sec": 8,
    "max_redirects": 10,
    "max_html_bytes": 1000000,
    "max_meta_refresh": 2,
    "allow_private_hosts": false,
    "user_agent": "Mozilla/5.0 (Linux; Android 14; SM-S918N) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36"
  },
  "domain_lookup": {
    "bootstrap_url": "https://data.iana.org/rdap/dns.json",
    "rdap_url": "https://rdap.org/domain/{domain}",
    "timeout_sec": 8
  },
  "safe_browsing": {
    "timeout_sec": 6,
    "threat_types": ["SOCIAL_ENGINEERING", "MALWARE", "UNWANTED_SOFTWARE", "POTENTIALLY_HARMFUL_APPLICATION"]
  },
  "phish_feed": {
    "url": "https://openphish.com/feed.txt",
    "refresh_minutes": 60
  },
  "ai": {
    "enabled": true,
    "model": "gemini-3.5-flash-lite",
    "timeout_sec": 25,
    "eval_timeout_sec": 120,
    "eval_retry_delays_sec": [30, 60, 120, 240],
    "max_requests_per_minute": 10,
    "max_text_chars": 3000,
    "min_confidence": 0.6,
    "mismatch_min_confidence": 0.8,
    "skip_if_rule_score_at_least": 90,
    "seed": 0,
    "url_cache_hours": 24
  },
  "jev": {
    "enabled": true,
    "model": "jev-latest",
    "timeout_sec": 10,
    "max_retries": 1
  },
  "notice": {
    "_설명": "QR 안내문 읽기(Gemini OCR). 카메라 프레임·업로드 사진을 긴 변 max_side px로 줄여 보낸다. 사진이 올라오는 순간 미리 읽기 시작한다.",
    "enabled": true,
    "max_side": 1024,
    "timeout_sec": 20,
    "min_chars": 8,
    "purposes": ["주차요금 결제", "음식 주문", "와이파이 접속", "택배·배송 조회", "공과금·관리비 납부", "충전 요금 결제",
                 "설문·민원 참여", "행사·이벤트 참여", "회원가입·본인인증", "메뉴·정보 보기", "앱 설치", "기타"]
  },
  "context": {
    "_설명": "맥락 일치 판정(Jev). 불일치 확률이 mismatch_strong 이상이면 강한 신호, mismatch_check 이상이면 약한 신호(확인 권장). 기준값은 eval/jev_*_results.md 근거, 실제 사진 측정 후 갱신 예정. Jev 실패 시 Gemini로 대신 판정(gemini_fallback).",
    "enabled": true,
    "mismatch_strong": 0.8,
    "mismatch_check": 0.5,
    "gemini_fallback": true,
    "jev_image_fallback": true,
    "jev_sticker_threshold": 0.8,
    "page_text_chars": 600
  },
  "screenshot": {
    "enabled": false
  },
  "download_extensions": [".apk", ".xapk", ".exe", ".msi", ".dmg", ".pkg", ".scr", ".bat", ".cmd", ".jar", ".ipa", ".vbs", ".ps1"],
  "download_content_types": [
    "application/vnd.android.package-archive",
    "application/x-msdownload",
    "application/x-msdos-program",
    "application/x-msi",
    "application/x-apple-diskimage",
    "application/java-archive",
    "application/octet-stream"
  ],
  "shorteners": [
    "bit.ly", "abit.ly", "han.gl", "me2.do", "naver.me", "vo.la", "url.kr", "t.ly", "tinyurl.com", "goo.gl",
    "ow.ly", "is.gd", "buly.kr", "c11.kr", "t.co", "rebrand.ly", "cutt.ly", "shorturl.at", "rb.gy", "bit.do",
    "lrl.kr", "zrr.kr", "link24.kr", "s.id", "qrco.de", "l.ead.me", "me-qr.com", "tny.im", "v.gd", "shorturl.asia"
  ],
  "hosting_platforms": [
    "github.io", "web.app", "firebaseapp.com", "pages.dev", "workers.dev", "vercel.app", "netlify.app",
    "herokuapp.com", "glitch.me", "weebly.com", "weeblysite.com", "wixsite.com", "wixstudio.com", "blogspot.com",
    "sites.google.com", "docs.google.com", "forms.gle", "storage.googleapis.com", "firebasestorage.googleapis.com",
    "r2.dev", "ipfs.io", "dweb.link", "s3.amazonaws.com", "azurewebsites.net", "web.core.windows.net",
    "000webhostapp.com", "square.site", "notion.site", "webflow.io", "framer.app", "framer.website",
    "godaddysites.com", "mystrikingly.com", "jimdosite.com", "yolasite.com", "ngrok-free.app", "ngrok.io",
    "trycloudflare.com", "translate.goog", "page.link", "replit.app", "repl.co", "surge.sh", "onrender.com",
    "fly.dev", "glide.page", "carrd.co", "tilda.ws", "wordpress.com", "blogger.com", "linktr.ee",
    "amazonaws.com", "cloudfront.net", "appspot.com", "googleapis.com", "googleusercontent.com", "azureedge.net",
    "cloudflare-ipfs.com", "digitaloceanspaces.com", "backblazeb2.com", "dropboxusercontent.com", "wcomhost.com", "sharepoint.com", "edgeone.dev", "edgeone.app", "cprapid.com", "homedns.org"
  ]
}
